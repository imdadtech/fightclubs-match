generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Discipline {
  BOXE_ANGLAISE
  MUAY_THAI
  KICK_BOXING
  K1
  MMA
}

enum Federation {
  FFB
  FFKMDA
  AUTRE
  NON_AFFILIE
}

model Club {
  id          String       @id @default(uuid())
  name        String       @db.VarChar(80)
  city        String
  postalCode  String       @db.Char(5)
  disciplines Discipline[]
  federations Federation[]

  // Contact pour organiser un combat (partagé avec les autres clubs)
  contactFirstName String
  contactLastName  String
  contactPhone     String?
  phoneHasWhatsapp Boolean  @default(false)
  shareEmail       Boolean  @default(false) // partage l'e-mail de connexion (User.email)
  sharePhone       Boolean  @default(false)
  sharingConsentAt DateTime

  users     User[]
  fighters  Fighter[]
  invites   FighterInvite[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  termsAcceptedAt DateTime
  club            Club?     @relation(fields: [clubId], references: [id])
  clubId          String?
  sessions        Session[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clubId])
}

model Session {
  id        String   @id @default(uuid())
  // SHA-256 du jeton du cookie : une fuite de la base ne donne pas de sessions valides
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum Sex {
  MALE
  FEMALE
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Fighter {
  id              String   @id @default(uuid())
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubId          String
  firstName       String
  lastName        String
  // Catégories de poids possibles, en kg (71 = « −71 kg », 63.5 = « −63,5 kg »)
  weightClassesKg Float[]
  sex             Sex
  birthDate       DateTime @db.Date
  heightCm        Int?
  // Mois où le combattant est disponible, au format « 2026-12 »
  availableMonths String[]

  // Palmarès par discipline (au moins une)
  records   FighterRecord[]
  invite    FighterInvite?
  // Renseigné quand le combattant a rempli sa fiche lui-même via un lien
  consentAt DateTime?

  proposalsSent     Proposal[] @relation("ProposalFrom")
  proposalsReceived Proposal[] @relation("ProposalTo")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([clubId])
}

// Un club propose à un autre un combat entre deux de leurs combattants.
model Proposal {
  id              String         @id @default(uuid())
  fromFighter     Fighter        @relation("ProposalFrom", fields: [fromFighterId], references: [id], onDelete: Cascade)
  fromFighterId   String
  toFighter       Fighter        @relation("ProposalTo", fields: [toFighterId], references: [id], onDelete: Cascade)
  toFighterId     String
  weightClassKg   Float
  // Mois souhaité (« 2026-12 »), repris des critères de recherche
  desiredMonth    String?
  status          ProposalStatus @default(PENDING)
  respondedAt     DateTime?
  // Le combat est confirmé quand les deux clubs l'ont déclaré
  fromConfirmedAt DateTime?
  toConfirmedAt   DateTime?
  createdAt       DateTime       @default(now())

  @@index([fromFighterId])
  @@index([toFighterId])
}

model FighterRecord {
  id         String     @id @default(uuid())
  fighter    Fighter    @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  fighterId  String
  discipline Discipline
  fights     Int
  wins       Int
  losses     Int

  @@unique([fighterId, discipline])
  @@index([discipline])
}

// Lien à usage unique envoyé par un club à un combattant pour qu'il remplisse sa fiche.
model FighterInvite {
  id        String    @id @default(uuid())
  // SHA-256 du jeton présent dans le lien
  tokenHash String    @unique
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubId    String
  expiresAt DateTime
  usedAt    DateTime?
  fighter   Fighter?  @relation(fields: [fighterId], references: [id], onDelete: SetNull)
  fighterId String?   @unique
  createdAt DateTime  @default(now())

  @@index([clubId])
}
